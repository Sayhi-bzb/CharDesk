{
  "name": "@chardesk/rendering",
  "version": "0.1.0",
  "description": "Shared CharDesk render models and Canvas 2D presentation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/CharDesk.git",
    "directory": "packages/rendering"
  },
  "homepage": "https://github.com/Sayhi-bzb/CharDesk/tree/main/packages/rendering#readme",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/CharDesk/issues"
  },
  "keywords": [
    "ansi",
    "canvas",
    "rendering",
    "unicode"
  ],
  "sideEffects": false,
