{
  "name": "@chardesk/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared CharDesk theme and UI primitives",
  "type": "module",
  "sideEffects": [
    "./theme.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./components/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./lib/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.17",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.23.26",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.5",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
