{
  "name": "@chardesk/chargraph",
  "version": "0.1.0",
  "description": "Pluggable source-to-Unicode rendering for CharDesk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/CharDesk.git",
    "directory": "packages/chargraph"
  },
  "homepage": "https://github.com/Sayhi-bzb/CharDesk/tree/main/packages/chargraph#readme",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/CharDesk/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.beautiful-mermaid",
    "LICENSE.marked-terminal",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./theme": {
      "types": "./dist/render-theme.d.ts",
      "import": "./dist/render-theme.js"
    },
    "./markdown": {
      "types": "./dist/markdown-default.d.ts",
      "import": "./dist/markdown-default.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./chart": {
      "types": "./dist/cartesian-chart.d.ts",
      "import": "./dist/cartesian-chart.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    }
  },
  "scripts": {
    "build:deps": "npm run build -w @chardesk/protocol && npm run build -w @chardesk/rendering",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build:deps",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/protocol": "^0.3.0",
    "@chardesk/rendering": "^0.1.0",
    "d3-scale": "^4.0.2",
    "elkjs": "^0.11.1",
    "jsonc-parser": "^3.3.1",
    "marked": "^16.4.1",
    "marked-alert": "^2.1.2",
    "saxes": "^6.0.0",
    "shiki": "^4.4.3",
    "temml": "^0.13.4",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9"
  }
}
