    "@chardesk/cell-core": "*",
    "@chardesk/protocol": "*",
    "@chardesk/document": "*",
    "yjs": "^13.6.27",
    "polygon-clipping": "^0.15.7",
    "@chardesk/keyboard": "*",
    "@tanstack/hotkeys": "0.8.0",
    "bresenham": "^0.0.4",
    "re2js": "^2.8.6"
  }
}
