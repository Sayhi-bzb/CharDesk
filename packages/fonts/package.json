{
  "name": "@chardesk/fonts",
  "version": "0.3.6",
  "description": "Core CharDesk symbol, Nerd Font, emoji fallbacks, and font profile factory",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/CharDesk.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/Sayhi-bzb/CharDesk/tree/main/packages/fonts#readme",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/CharDesk/issues"
  },
  "keywords": [
    "ascii",
    "canvas",
    "fonts",
    "unicode"
  ],
  "sideEffects": [
    "./fonts.css"
  ],
  "files": [
    "assets",
    "dist",
    "fonts.css",
    "manifest.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts.css": "./fonts.css",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/protocol": "^0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
