{
  "name": "@chardesk/viewer",
  "version": "0.1.0",
  "description": "DOM-first Unicode and ANSI viewer for CharDesk text",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sayhi-bzb/CharDesk.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/Sayhi-bzb/CharDesk/tree/main/packages/viewer#readme",
  "bugs": {
    "url": "https://github.com/Sayhi-bzb/CharDesk/issues"
  },
  "keywords": [
    "ansi",
    "ascii",
    "unicode",
    "viewer",
    "web-component"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/cell-core": "^0.3.7",
    "@chardesk/chargraph": "^0.1.0",
    "@chardesk/font-maple": "^0.3.0",
    "@chardesk/protocol": "^0.3.0",
    "@chardesk/rendering": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
