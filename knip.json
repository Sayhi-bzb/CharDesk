{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/main.tsx",
        "src/app/App.tsx",
        "src/domains/*/public.ts",
        "src/widgets/dialogs/clear-canvas-dialog.tsx",
        "exp/web-tui/main.tsx",
        "scripts/**/*.{mjs,ts}",
        "e2e/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "exp/web-tui/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "e2e/**/*.ts",
        "*.config.{ts,js}"
      ]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fonts": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/document": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/chargraph": {
      "entry": ["src/index.ts", "src/mermaid.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/styles.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/blackboard": {
      "entry": [
        "src/node.ts",
        "src/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "*.config.ts"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "src/raster-worker.ts",
        "src/**/*.test.ts",
        "scripts/build.mjs",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/*.mjs", "*.config.ts"],
      "ignoreDependencies": [
        "d3-scale",
        "elkjs",
        "jsonc-parser",
        "marked",
        "marked-alert",
        "saxes",
        "shiki",
        "temml"
      ]
    },
    "apps/docs": {
      "entry": [
        "app/root.tsx",
        "app/routes.ts",
        "app/routes/*.tsx",
        "app/routes/*.ts",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "*.config.ts"]
    },
    "apps/chargraph": {
      "entry": ["src/main.tsx", "src/**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "tags": ["-internal"],
  "ignore": [
    "packages/chargraph/src/vendor/**",
    "packages/document/document/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css"
  ]
}
