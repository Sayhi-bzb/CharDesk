{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}",
        "vitest.config.ts"
      ],
      "project": [
        "scripts/**/*.{ts,mjs}",
        "*.config.{ts,js}"
      ]
    },
    "apps/canvas": {
      "entry": [
        "src/app/main.tsx",
        "src/app/App.tsx",
        "src/mcp-contracts.d.ts",
        "src/domains/*/public.ts",
        "src/widgets/dialogs/clear-canvas-dialog.tsx",
        "e2e/**/*.ts",
        "functions/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "functions/**/*.ts", "*.config.ts"]
    },
    "apps/site": {
      "entry": ["src/main.tsx", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fonts": {
      "entry": ["src/index.ts", "src/browser.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/document": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/chargraph": {
      "entry": ["src/index.ts", "src/mermaid.ts", "src/**/*.test.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/styles.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/legacy-blackboard": {
      "entry": [
        "src/node.ts",
        "src/**/*.test.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "*.config.ts"]
    },
    "packages/mcp": {
      "entry": ["bin/chardesk-mcp.mjs", "src/server.mjs", "src/broker-process.mjs", "src/tools.mjs", "src/tools.d.mts"],
      "project": ["bin/*.mjs", "src/**/*.{mjs,mts}"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "src/raster-worker.ts",
        "src/**/*.test.ts",
        "scripts/build.mjs",
        "scripts/build-local.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/*.{mjs,ts}", "*.config.ts"],
      "ignoreDependencies": [
        "d3-scale",
        "elkjs",
        "jsonc-parser",
        "marked",
        "marked-alert",
        "saxes",
        "shiki",
        "temml",
        "@opentui/core",
        "@napi-rs/clipboard",
        "@teddyzhu/clipboard",
        "quickjs-emscripten",
        "ajv"
      ]
    },
    "packages/canvas-capabilities": {
      "entry": ["src/contracts.mjs", "src/contracts.d.mts"],
      "project": ["src/**/*.{ts,mjs,mts}"]
    },
    "packages/terminal": {
      "entry": ["src/main.ts", "scripts/snapshotFonts.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "examples/terminal-canvas": {
      "entry": ["src/main.ts", "src/**/*.test.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "packages/docs-ui": {
      "entry": ["src/index.ts", "src/layout.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/docs": {
      "entry": [
        "app/root.tsx",
        "app/routes.ts",
        "app/routes/*.tsx",
        "app/routes/*.ts",
        "reader/root.tsx",
        "reader/routes.ts",
        "reader/routes/*.{ts,tsx}",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "reader/**/*.{ts,tsx}", "*.config.ts"]
    },
    "apps/chargraph": {
      "entry": ["src/main.tsx", "src/**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    },
    "apps/cell-ui": {
      "entry": ["src/main.tsx", "src/component-props.typecheck.ts", "src/**/*.test.ts", "src/**/*.dom.test.tsx", "e2e/**/*.ts", "functions/**/*.ts", "*.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "functions/**/*.ts", "*.config.ts"]
    },
    "packages/cell-ui": {
      "entry": ["src/index.ts", "src/browser.tsx", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.dom.test.ts", "src/**/*.dom.test.tsx", "vitest.config.ts", "vitest.browser.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "tags": ["-internal"],
  "ignoreExportsUsedInFile": { "type": true },
  "ignore": [
    "packages/chargraph/src/vendor/**",
    "packages/document/document/**"
  ],
  "ignoreDependencies": [
    "tw-animate-css"
  ]
}
