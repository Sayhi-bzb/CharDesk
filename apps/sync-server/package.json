{
  "name": "@chardesk/sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=.env.local dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@chardesk/collaboration-protocol": "*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
