{
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/chargraph/src/*"],
      "@chardesk/chargraph": ["packages/chargraph/src/index.ts"],
      "@chardesk/chargraph/examples": ["packages/chargraph/src/examples.ts"],
      "@chardesk/chargraph/markdown": ["packages/chargraph/src/markdown-default.ts"],
      "@chardesk/chargraph/mermaid": ["packages/chargraph/src/mermaid.ts"],
      "@chardesk/chargraph/theme": ["packages/chargraph/src/render-theme.ts"],
      "@chardesk/fonts": ["packages/fonts/src/index.ts"],
      "@chardesk/font-maple": ["packages/font-maple/src/index.ts"],
      "@chardesk/protocol": ["packages/protocol/src/index.ts"],
      "@chardesk/rendering": ["packages/rendering/src/index.ts"],
      "@chardesk/rendering/canvas": ["packages/rendering/src/canvas.ts"],
      "@chardesk/ui": ["packages/ui/src/index.ts"],
      "@chardesk/ui/styles": ["packages/ui/src/styles.ts"],
      "@chardesk/viewer": ["packages/viewer/src/index.ts"]
    },
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "react", "react-dom"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "*.config.ts"]
}
